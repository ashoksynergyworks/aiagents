{
  "name": "doctor-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "test": "node --experimental-strip-types --no-warnings scripts/check-guard.mjs && node --experimental-strip-types --no-warnings scripts/check-kpis.mjs && node --experimental-strip-types --no-warnings scripts/check-model.mjs",
    "test:phi": "node --env-file=.env --experimental-strip-types --no-warnings scripts/check-phi.mjs"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "openai": "^7.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
